---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Motif from '@/components/ui/Motif.astro';
import { t, tList, type Locale } from '@/lib/i18n';
import { preventWidows } from '@/lib/typography';
import ropeBoxes from '@/assets/packaging/rope-boxes.jpg';
import greenBento from '@/assets/packaging/green-bento.jpg';
import kraftBag from '@/assets/packaging/kraft-bag.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const points = tList<string>(locale, 'packaging.points').map((point) => preventWidows(point));
const packagingTitle = t(locale, 'packaging.title');
const titleLines =
  locale === 'en' ? ['Crafted Beyond', 'the Kitchen'] : [packagingTitle];
---

<Section id="packaging" theme="oud" labelledby="pkg-title">
  <div class="container pkg">
    <div class="pkg__text" data-animate>
      <p class="eyebrow"><Motif name="diamond" />{t(locale, 'packaging.eyebrow')}</p>
      <h2 id="pkg-title" class="pkg__title">
        {titleLines.map((line) => (
          <span>{line}</span>
        ))}
      </h2>
      <p class="lead pkg__body measure">{preventWidows(t(locale, 'packaging.body'))}</p>
      <ul class="pkg__points" role="list">
        {
          points.map((p) => (
            <li>
              <Motif name="diamond" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="pkg__media" data-animate data-animate-delay="120" aria-label="DASTUR packaging gallery">
      <figure class="pkg__slide pkg__slide--1">
        <Image
          src={ropeBoxes}
          alt="Three cream DASTUR rope-handle boxes with green rims and the engraved heritage skyline."
          widths={[520, 820, 1100]}
          sizes="(max-width: 980px) 90vw, 50vw"
          loading="lazy"
        />
      </figure>
      <figure class="pkg__slide pkg__slide--2">
        <Image
          src={greenBento}
          alt="Palm-green DASTUR bento carry-box with dates, luqaimat and machboos."
          widths={[520, 820, 1100]}
          sizes="(max-width: 980px) 90vw, 50vw"
          loading="lazy"
        />
      </figure>
      <figure class="pkg__slide pkg__slide--3">
        <Image
          src={kraftBag}
          alt="Kraft DASTUR delivery bag with a palm-green band and heritage skyline."
          widths={[520, 820, 1100]}
          sizes="(max-width: 980px) 90vw, 50vw"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</Section>

<style>
  .pkg {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  .pkg__text {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }
  .pkg__title {
    font-size: var(--fs-h2);
    color: var(--sand);
    max-width: none;
    white-space: normal;
  }
  .pkg__title span {
    display: block;
    white-space: nowrap;
  }
  .pkg__body {
    color: var(--on-dark-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .pkg__points {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  .pkg__points li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--sand);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .pkg__points :global(.motif) {
    width: 1rem;
    height: 1rem;
    color: var(--brass-300);
    flex-shrink: 0;
  }

  .pkg__media {
    position: relative;
    display: block;
    min-height: clamp(320px, 42vw, 520px);
    overflow: hidden;
    background: #e9dfd0;
  }
  .pkg__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    background: #e9dfd0;
    opacity: 0;
  }
  .pkg__slide--1 {
    opacity: 1;
  }
  .pkg__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pkg__slide {
      animation: pkg-fade 12s infinite;
      opacity: 0;
    }
    .pkg__slide--1 { animation-delay: 0s; }
    .pkg__slide--2 { animation-delay: 4s; }
    .pkg__slide--3 { animation-delay: 8s; }
    @keyframes pkg-fade {
      0%,
      4% { opacity: 0; }
      8%,
      30% { opacity: 1; }
      36%,
      100% { opacity: 0; }
    }
  }

  @media (min-width: 900px) {
    .pkg {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  @media (max-width: 899px) {
    .pkg__media {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }
</style>
