---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Motif from '@/components/ui/Motif.astro';
import { t, type Locale } from '@/lib/i18n';
import { preventWidows } from '@/lib/typography';
import heritage from '@/assets/story/heritage-landscape.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const symbols = [
  { key: 'land', motif: 'palm' as const },
  { key: 'sea', motif: 'dhow' as const },
  { key: 'craft', motif: 'windtower' as const },
];
---

<Section id="story" theme="sand" labelledby="story-title" flush>
  <div class="container story">
    <div class="story__copy">
      <p class="eyebrow" data-animate>
        <Motif name="diamond" />{t(locale, 'story.eyebrow')}
      </p>
      <h2 class="story__title" id="story-title" data-animate data-animate-delay="60">
        {t(locale, 'story.title')}
      </h2>
      <div class="story__body" data-animate data-animate-delay="120">
        <p>{preventWidows(t(locale, 'story.p1'))}</p>
        <p>{preventWidows(t(locale, 'story.p2'))}</p>
        <p>{preventWidows(t(locale, 'story.p3'))}</p>
      </div>

      <div class="story__symbols" data-animate data-animate-delay="180">
        <ul role="list">
          {
            symbols.map((s) => (
              <li class="symbol">
                <span class="symbol__ico"><Motif name={s.motif} /></span>
                <div>
                  <h3 class="symbol__title">{preventWidows(t(locale, `story.symbols.${s.key}`))}</h3>
                  <p class="symbol__desc">{preventWidows(t(locale, `story.symbols.${s.key}Desc`))}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="story__media">
      <Image
        src={heritage}
        alt={
          locale === 'en'
            ? 'Heritage waterfront with a dhow, wind towers, and a still life of bowl and vase'
            : 'واجهة تراثية على الماء مع سفينة وبرج هواء ومائدة هادئة'
        }
        widths={[720, 1100, 1600, 2000]}
        sizes="(max-width: 899px) 92vw, 48vw"
        loading="lazy"
        class="story__img"
      />
    </figure>
  </div>
</Section>

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 1.25rem;
    min-height: 0;
  }

  .story__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.7rem;
    min-width: 0;
    min-height: 0;
  }

  .story__title {
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    max-width: 13ch;
    line-height: 1.06;
    text-wrap: balance;
  }

  .story__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .story__body p {
    line-height: 1.5;
  }

  .story__symbols {
    width: 100%;
    margin-top: 0;
    padding-top: 0.7rem;
    border-top: 1px solid rgb(52 88 70 / 0.2);
  }

  .story__symbols ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .symbol {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    min-width: 0;
  }

  .symbol__ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(52 88 70 / 0.28);
    border-radius: 50%;
    color: #345846;
    background: rgb(52 88 70 / 0.1);
  }

  .symbol__ico :global(.motif) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .symbol__title {
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
  }

  .symbol__desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .story__media {
    position: relative;
    margin: 0;
    width: 100%;
    min-width: 0;
    min-height: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e4d8c6;
  }

  .story__media :global(img),
  .story__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 62% 68%;
  }

  @media (min-width: 900px) {
    .story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      align-items: stretch;
      gap: clamp(1.25rem, 3vw, 2.5rem);
      height: auto;
    }

    .story__symbols ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .symbol {
      flex-direction: column;
      gap: 0.4rem;
    }

    .story__media {
      height: auto;
      min-height: 100%;
      max-height: none;
      align-self: stretch;
      aspect-ratio: auto;
    }
  }
</style>
