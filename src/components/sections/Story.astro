---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Motif from '@/components/ui/Motif.astro';
import { t, type Locale } from '@/lib/i18n';
import { preventWidows } from '@/lib/typography';
import heritage from '@/assets/story/heritage-landscape.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const symbols = [
  { key: 'land', motif: 'palm' as const },
  { key: 'sea', motif: 'dhow' as const },
  { key: 'craft', motif: 'windtower' as const },
];
---

<Section id="story" theme="sand" labelledby="story-title" flush>
  <div class="story">
    <div class="story__backdrop" aria-hidden="true">
      <Image
        src={heritage}
        alt=""
        widths={[1200, 1600, 2000, 2400]}
        sizes="100vw"
        loading="lazy"
        class="story__bg"
      />
      <div class="story__scrim"></div>
    </div>

    <div class="container story__content">
      <div class="story__panel">
        <p class="eyebrow" data-animate>
          <Motif name="diamond" />{t(locale, 'story.eyebrow')}
        </p>
        <h2 class="story__title" id="story-title" data-animate data-animate-delay="60">
          {t(locale, 'story.title')}
        </h2>
        <div class="story__body" data-animate data-animate-delay="120">
          <p>{preventWidows(t(locale, 'story.p1'))}</p>
          <p>{preventWidows(t(locale, 'story.p2'))}</p>
          <p>{preventWidows(t(locale, 'story.p3'))}</p>
        </div>
      </div>

      <div class="story__symbols" data-animate data-animate-delay="180">
        <ul role="list">
          {
            symbols.map((s) => (
              <li class="symbol">
                <span class="symbol__ico"><Motif name={s.motif} /></span>
                <div>
                  <h3 class="symbol__title">{preventWidows(t(locale, `story.symbols.${s.key}`))}</h3>
                  <p class="symbol__desc">{preventWidows(t(locale, `story.symbols.${s.key}Desc`))}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>

<style>
  .story {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: clamp(36rem, 78vh, 50rem);
    overflow: hidden;
  }

  .story__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .story__backdrop :global(img),
  .story__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 72%;
  }

  .story__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      102deg,
      rgb(247 241 230 / 0.98) 0%,
      rgb(247 241 230 / 0.95) 30%,
      rgb(247 241 230 / 0.78) 48%,
      rgb(247 241 230 / 0.35) 68%,
      rgb(247 241 230 / 0.1) 100%
    );
  }

  .story__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.75rem, 3vw, 2.5rem);
    min-height: inherit;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .story__panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: min(46rem, 52%);
  }

  .story__title {
    font-size: var(--fs-h2);
    max-width: 13ch;
    line-height: 1.1;
  }

  .story__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--text-muted);
    max-width: 50ch;
  }

  .story__body p {
    line-height: 1.8;
  }

  .story__symbols {
    max-width: min(56rem, 64%);
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 1px solid rgb(52 88 70 / 0.2);
  }

  .story__symbols ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .symbol {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .symbol__ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgb(52 88 70 / 0.28);
    border-radius: 50%;
    color: #345846;
    background: rgb(52 88 70 / 0.1);
  }

  .symbol__ico :global(.motif) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .symbol__title {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .symbol__desc {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.55;
  }

  @media (max-width: 899px) {
    .story {
      min-height: auto;
    }

    .story__scrim {
      background: linear-gradient(
        180deg,
        rgb(247 241 230 / 0.97) 0%,
        rgb(247 241 230 / 0.93) 55%,
        rgb(247 241 230 / 0.82) 100%
      );
    }

    .story__panel,
    .story__symbols {
      max-width: 100%;
    }

    .story__symbols ul {
      grid-template-columns: 1fr;
    }
  }
</style>
