---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import { galleryItems } from '@/config/gallery';
import { t, type Locale } from '@/lib/i18n';
import { preventWidows } from '@/lib/typography';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const foodPhotos = [
  { image: 'rice.jpg', en: 'Fragrant signature rice', ar: 'أرز مميز عطري' },
  { image: 'dessert.jpg', en: 'A sweet ending', ar: 'ختام حلو' },
  { image: 'grill.jpg', en: 'From the grill', ar: 'من المشواة' },
  { image: 'coffee-dates.jpg', en: 'Coffee and hospitality', ar: 'قهوة وضيافة' },
];
const packaging = galleryItems.filter((item) => item.kind === 'photo').slice(0, 2);
---

<Section id="gallery" theme="sand" labelledby="gal-title">
  <div class="container heritage-gallery">
    <div class="heritage-gallery__heading">
      <p class="eyebrow">{t(locale, 'gallery.eyebrow')}</p>
      <h2 id="gal-title">{preventWidows(t(locale, 'gallery.title'))}</h2>
      <p>{preventWidows(t(locale, 'gallery.intro'))}</p>
    </div>
    <div class="heritage-gallery__canvas">
      {foodPhotos.map((photo, i) => (
        <figure class={`heritage-gallery__tile heritage-gallery__tile--${i + 1}`}>
          <div class="heritage-gallery__arch">
            <img src={`/images/menu-food/${photo.image}`} alt={photo[locale]} width="600" height="750" loading="lazy" />
          </div>
          <figcaption>{photo[locale]}</figcaption>
        </figure>
      ))}
      {packaging.map((item, i) => (
        <figure class={`heritage-gallery__tile heritage-gallery__tile--${i + 5}`}>
          <div class="heritage-gallery__arch heritage-gallery__arch--packaging">
            {item.image && <Image src={item.image} alt={item.alt[locale]} widths={[320, 560, 820]} sizes="(max-width: 700px) 42vw, 20vw" loading="lazy" />}
          </div>
          <figcaption>{locale === 'en' ? 'Wrapped in heritage' : 'مغلف بالتراث'}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</Section>

<style>
  .heritage-gallery__heading { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; max-width: 42rem; margin: 0 auto 2rem; }
  .heritage-gallery__heading h2 { color: var(--palm); font-size: clamp(2rem, 4vw, 3.8rem); line-height: 1.2; letter-spacing: .03em; }
  .heritage-gallery__heading > p:last-child { color: var(--oud); line-height: 1.7; }
  .heritage-gallery__canvas { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: stretch; gap: clamp(1rem, 1.5vw, 1.5rem); }
  .heritage-gallery__tile { width: 100%; min-width: 0; margin: 0; display: flex; flex-direction: column; }
  .heritage-gallery__arch {
    flex: 1;
    min-height: 0;
    background: #dfd2ba;
    overflow: hidden;
  }
  .heritage-gallery__arch img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .heritage-gallery__tile:hover .heritage-gallery__arch:not(.heritage-gallery__arch--packaging) img { transform: scale(1.04); }
  .heritage-gallery__arch--packaging { padding: 1rem; background: #e9dfcd; aspect-ratio: 4 / 3; border-radius: 1rem; }
  .heritage-gallery__arch--packaging img { object-fit: contain; }
  .heritage-gallery__tile figcaption { color: var(--palm); font-size: .72rem; letter-spacing: .05em; text-align: center; margin-top: .7rem; }
  .heritage-gallery__tile--1 { grid-column: 1; grid-row: span 2; }
  .heritage-gallery__tile--2 { grid-column: 2; }
  .heritage-gallery__tile--3 { grid-column: 3; grid-row: span 2; }
  .heritage-gallery__tile--4 { grid-column: 4; }
  .heritage-gallery__tile--5 { grid-column: 2; }
  .heritage-gallery__tile--6 { grid-column: 4; }
  .heritage-gallery__tile--1 .heritage-gallery__arch,
  .heritage-gallery__tile--3 .heritage-gallery__arch { aspect-ratio: 4 / 5; }
  .heritage-gallery__tile--2 .heritage-gallery__arch,
  .heritage-gallery__tile--4 .heritage-gallery__arch { aspect-ratio: 1; border-radius: 1rem; }
  @media (max-width: 700px) {
    .heritage-gallery__canvas { height: auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; }
    .heritage-gallery__tile { grid-column: auto; grid-row: auto; width: 100%; padding-top: 0; align-self: stretch; }
    .heritage-gallery__tile .heritage-gallery__arch { flex: 1; aspect-ratio: 4 / 5; }
    .heritage-gallery__tile--2 .heritage-gallery__arch { aspect-ratio: 1; flex: 0; }
    .heritage-gallery__tile--2 { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .heritage-gallery__arch img { transition: none; }
    .heritage-gallery__tile:hover .heritage-gallery__arch img { transform: none; }
  }
</style>
